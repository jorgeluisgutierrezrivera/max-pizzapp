# ==========================================================
# Plantilla de variables de entorno — Max Pizzapp
# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA se sube al repositorio (requisito #7).
# ==========================================================

# --- Base de datos PostgreSQL ---
POSTGRES_DB=maxpizzapp
POSTGRES_USER=cambia_este_usuario
POSTGRES_PASSWORD=cambia_esta_contrasena
# En desarrollo el puerto NO se publica (ver docker-compose.yml). Si se
# descomenta para inspeccionar la base con una herramienta externa, usar 5433:
# el 5432 lo ocupa el sistema anterior en la maquina de desarrollo.
POSTGRES_PORT=5433

# --- Backend / API ---
NODE_ENV=development
# El 3000 lo ocupa el sistema anterior en la maquina de desarrollo.
API_PORT=3001

# --- Keycloak ---
# Puerto del host en desarrollo: 8082. El 8080 esta reservado por winnat en
# Windows (E-001) y el 8081 lo ocupa el sistema anterior en esta maquina.
KEYCLOAK_PORT=8082
KEYCLOAK_REALM=maxpizzapp
# La audiencia que la API exige en los tokens. La API no inicia sesiones: solo valida
# tokens, asi que no tiene secreto de cliente.
KEYCLOAK_CLIENT_ID=backend-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambia_esta_contrasena_admin
# Contrasena de las cuentas de demostracion (recepcion.demo, cocina.demo).
# El realm versionado no trae contrasenas: se establecen desde aqui.
KEYCLOAK_DEMO_PASSWORD=cambia_esta_contrasena_demo
# En desarrollo la API alcanza Keycloak por la red interna de Docker.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# ==========================================================
# Solo PRODUCCIÓN (VPS + Caddy).
#
# Estas dos variables NO se usan en desarrollo, y en el servidor
# son obligatorias: sin ellas, Caddy no sabe para qué dominio
# pedir el certificado y Keycloak no sabe qué emisor escribir en
# los tokens.
#
# El .env de producción NO es una copia de este archivo con los
# valores de desarrollo: las contraseñas se generan en el servidor
# y no salen de ahí.
# ==========================================================

# Dominio raíz, SIN protocolo y SIN barra final (ejemplo:
# maxpizzapp.com). De aquí salen las dos direcciones del sistema:
#   https://${DOMINIO}        -> aplicación y API
#   https://auth.${DOMINIO}   -> Keycloak
# El issuer de los tokens se deriva de esta variable en
# docker-compose.prod.yml; no se declara aparte, para que no haya
# dos sitios donde el dominio pueda quedar desincronizado.
DOMINIO=

# Correo al que Let's Encrypt avisa si un certificado está por
# expirar sin haberse renovado. No se publica en ningún sitio.
CADDY_EMAIL=

# Opcional: la carpeta del servidor de donde Caddy sirve la app
# publicada (scripts/publicar-web.sh). Por omisión, /opt/maxpizzapp-web.
# WEB_DIR=/opt/maxpizzapp-web
