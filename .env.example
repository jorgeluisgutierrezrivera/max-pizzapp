# ==========================================================
# Plantilla de variables de entorno — Max Pizzapp
# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA se sube al repositorio (requisito #7).
# ==========================================================

# --- Base de datos PostgreSQL ---
POSTGRES_DB=maxpizzapp
POSTGRES_USER=cambia_este_usuario
POSTGRES_PASSWORD=cambia_esta_contrasena
# En desarrollo el puerto NO se publica (ver docker-compose.yml). Si se
# descomenta para inspeccionar la base con una herramienta externa, usar 5433:
# el 5432 lo ocupa el sistema anterior en la maquina de desarrollo.
POSTGRES_PORT=5433

# --- Backend / API ---
NODE_ENV=development
# El 3000 lo ocupa el sistema anterior en la maquina de desarrollo.
API_PORT=3001

# --- Keycloak ---
# Puerto del host en desarrollo: 8082. El 8080 esta reservado por winnat en
# Windows (E-001) y el 8081 lo ocupa el sistema anterior en esta maquina.
KEYCLOAK_PORT=8082
KEYCLOAK_REALM=maxpizzapp
KEYCLOAK_CLIENT_ID=backend-api
KEYCLOAK_CLIENT_SECRET=cambia_este_secreto
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambia_esta_contrasena_admin
# En desarrollo la API alcanza Keycloak por la red interna de Docker.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# ==========================================================
# Solo PRODUCCIÓN (VM + Caddy).
# Descomentar y completar al desplegar.
# ==========================================================
# DOMINIO=midominio
# Base propia de Keycloak en Postgres (modo start / producción):
# KEYCLOAK_DB_USER=keycloak
# KEYCLOAK_DB_PASSWORD=cambia_esta_contrasena_kc
# El issuer DEBE ser la URL pública o la API rechaza los tokens:
# KC_HOSTNAME=https://auth.midominio
