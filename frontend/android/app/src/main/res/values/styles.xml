<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mientras el proceso arranca, en Android 7 a 11: el fondo crema con el icono al centro.
         Desde Android 12 manda values-v31. El tema es claro y fijo, como en la web (D-29): no
         hay estilos de noche, para que el arranque no sea negro en un telefono en modo oscuro. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Detras de Flutter mientras dibuja el primer cuadro, y despues: el mismo crema, para que
         no haya un destello blanco entre el arranque y la app. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/crema_fondo</item>
    </style>
</resources>
