# ============================================================
# Max Pizzapp — .gitignore
# Nada de secretos, dependencias ni artefactos de build en el repo.
# ============================================================

# --- Secretos y entorno (requisito #7: fuera del repo) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
credentials.json
serviceAccount*.json

# --- Node / Backend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Flutter / Frontend ---
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/build/
frontend/.pub-cache/
frontend/.pub/
**/doc/api/
# frontend/pubspec.lock SI se versiona: fija las versiones exactas del build, como
# package-lock.json en el backend.
# frontend/web/ SI se versiona: tiene el index.html y el manifiesto de la aplicacion.
# Lo que se genera y no se versiona es frontend/build/ (ignorado arriba).

# --- Pruebas de extremo a extremo (Python) ---
__pycache__/
*.pyc
.venv/

# --- Cobertura de pruebas (se genera) ---
coverage/

# --- Docker / datos persistentes ---
docker/postgres/data/
*.pgdata

# --- Respaldos de la base: nunca en el repo, tienen datos reales ---
*.dump
*.sql.gz
dump.sql
respaldos/

# --- Caddy (certificados y estado, se generan) ---
docker/caddy/data/
docker/caddy/config/

# --- Logs y temporales ---
logs/
tmp/
temp/

# --- Documentos abiertos en Word o Excel (los definitivos SI se versionan en docs/) ---
~$*.docx
~$*.xlsx

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editores / IDE ---
.idea/
.vscode/
*.iml
*.swp

# --- Andamiaje de asistentes/agentes de IA (no es parte del proyecto) ---
# Archivos y carpetas de trabajo de agentes de código y del editor.
# Se ignoran para mantener el repositorio enfocado solo en el proyecto.
.claude/
CLAUDE.local.md
.cursor/
.aider*
.windsurf/
.continue/
.codeium/
.github/copilot/
